{
  "brand_identity": {
    "name": "HUNTIQ V3 BIONIC",
    "vision": "Tactical Luxury meets Biological Intelligence. A fusion of high-tech data analysis and raw outdoor experience.",
    "tone": "Professional, Immersive, Tactical, Premium, Authoritative.",
    "target_audience": "Quebec Hunters (30-60yo), Outfitters, Outdoor Enthusiasts."
  },
  "design_system": {
    "colors": {
      "primary": {
        "DEFAULT": "#0a0a0a",
        "foreground": "#ffffff",
        "description": "Deep Obsidian - Main background"
      },
      "secondary": {
        "DEFAULT": "#1a1a1a",
        "foreground": "#e5e5e5",
        "description": "Tactical Grey - Surface/Cards"
      },
      "accent": {
        "DEFAULT": "#f5a623",
        "foreground": "#000000",
        "description": "Bionic Gold - Primary Action/Highlight"
      },
      "muted": {
        "DEFAULT": "#262626",
        "foreground": "#a3a3a3",
        "description": "Dark Grey - Borders/Separators"
      },
      "destructive": {
        "DEFAULT": "#7f1d1d",
        "foreground": "#fef2f2",
        "description": "Alert/Danger"
      },
      "success": {
        "DEFAULT": "#14532d",
        "foreground": "#f0fdf4",
        "description": "Optimal Conditions"
      }
    },
    "typography": {
      "headings": {
        "font_family": "Barlow Condensed, sans-serif",
        "weights": ["600", "700", "800"],
        "style": "Uppercase, tight tracking",
        "usage": "Section titles, Hero text, Data values"
      },
      "body": {
        "font_family": "Inter, sans-serif",
        "weights": ["400", "500"],
        "style": "Clean, legible",
        "usage": "Paragraphs, UI labels"
      },
      "mono": {
        "font_family": "JetBrains Mono, monospace",
        "weights": ["400"],
        "style": "Technical",
        "usage": "Coordinates, Weather data, Analytics"
      }
    },
    "spacing": {
      "container_padding": "p-4 md:p-8 lg:p-12",
      "section_gap": "gap-8 md:gap-12",
      "grid_gap": "gap-4 md:gap-6"
    },
    "radius": {
      "default": "rounded-sm",
      "button": "rounded-sm",
      "card": "rounded-md"
    },
    "effects": {
      "glass": "bg-black/60 backdrop-blur-xl border border-white/10",
      "neon_glow": "shadow-[0_0_15px_rgba(245,166,35,0.3)]",
      "scanline": "bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(255,0,0,0.06),rgba(0,255,0,0.02),rgba(0,0,255,0.06))]"
    }
  },
  "assets": {
    "images": {
      "hero_bg": "https://images.unsplash.com/photo-1767658592234-11e91cada144?q=85&w=1920&auto=format&fit=crop",
      "map_texture": "https://images.unsplash.com/photo-1736117704452-46670dd0c81f?q=85&w=1000&auto=format&fit=crop",
      "weather_bg": "https://images.unsplash.com/photo-1627891858448-0b99239685fa?q=85&w=1000&auto=format&fit=crop",
      "community_bg": "https://images.unsplash.com/photo-1650943762596-7f55cd642776?q=85&w=1000&auto=format&fit=crop",
      "species_moose": "https://images.unsplash.com/photo-1581971000802-30e846b262ed?q=85&w=800&auto=format&fit=crop",
      "gear_scope": "https://images.unsplash.com/photo-1725469065847-537973a71806?q=85&w=800&auto=format&fit=crop",
      "hunter_silhouette": "https://images.unsplash.com/photo-1768971622790-eaf71902627b?q=85&w=1000&auto=format&fit=crop"
    },
    "icons": "lucide-react"
  },
  "layout_strategy": {
    "type": "Bento Grid Hybrid",
    "description": "A mix of immersive full-width sections and dense data grids.",
    "sections": [
      {
        "id": "hero",
        "name": "1. Section Héro Immersive",
        "type": "Full Screen",
        "content": "Video background/Parallax, 'BIONIC' branding, CTA 'Explorer le Territoire'",
        "style": "Immersive, High Impact"
      },
      {
        "id": "carousel",
        "name": "2. Carrousel Dynamique",
        "type": "Slider",
        "content": "Featured products, Attractants, New Gear",
        "style": "Card-based, Horizontal Scroll"
      },
      {
        "id": "map_module",
        "name": "3. Carte Interactive (Mapbox)",
        "type": "Interactive Widget",
        "content": "3D Terrain view, Hotspots, Zones",
        "style": "Technical, Data-heavy"
      },
      {
        "id": "analysis_grid",
        "name": "4-8. Analyse & Données",
        "type": "Bento Grid (Dense)",
        "sub_modules": [
          "4. Analyse Terrain",
          "5. Météo + Conditions",
          "6. Territoires en vedette",
          "7. Espèces en vedette",
          "8. Chasse Intelligente (IA)"
        ],
        "style": "Dashboard style, high density, glassmorphism cards"
      },
      {
        "id": "marketplace",
        "name": "9. Marketplace",
        "type": "Grid",
        "content": "Top rated items, Flash sales",
        "style": "E-commerce clean"
      },
      {
        "id": "media_hub",
        "name": "10-11. Media & Formation",
        "type": "Split Section",
        "sub_modules": ["10. Hunt TV (YouTube)", "11. Formations"],
        "style": "Dark cinema mode"
      },
      {
        "id": "live_stats",
        "name": "12-13. Live Data",
        "type": "Ticker/Bar",
        "sub_modules": ["12. Stats Temps Réel", "13. Alertes"],
        "style": "Stock market ticker style, urgent"
      },
      {
        "id": "partners",
        "name": "14. Partenaires",
        "type": "Logo Grid",
        "style": "Monochrome logos, opacity 50%"
      },
      {
        "id": "content_seo",
        "name": "15. Blog / SEO",
        "type": "List/Cards",
        "style": "Editorial, readable"
      },
      {
        "id": "community",
        "name": "16. Communauté",
        "type": "Image Grid/Masonry",
        "content": "User photos, Forum highlights",
        "style": "Organic, friendly"
      },
      {
        "id": "mobile_app",
        "name": "17. App Mobile",
        "type": "Feature Split",
        "content": "Phone mockup, App Store links",
        "style": "Clean, promotional"
      },
      {
        "id": "newsletter",
        "name": "18. Newsletter",
        "type": "Banner",
        "style": "High contrast, Gold background option"
      },
      {
        "id": "footer",
        "name": "19. Footer",
        "type": "Mega Footer",
        "style": "Detailed, sitemap, legal"
      }
    ]
  },
  "component_rules": {
    "buttons": {
      "primary": "bg-[#f5a623] text-black hover:bg-[#d9901c] font-bold uppercase tracking-wider rounded-sm",
      "secondary": "bg-white/10 text-white hover:bg-white/20 backdrop-blur-md border border-white/10 rounded-sm",
      "outline": "border border-[#f5a623] text-[#f5a623] hover:bg-[#f5a623]/10 rounded-sm"
    },
    "cards": {
      "base": "bg-[#1a1a1a] border border-white/5 rounded-md overflow-hidden",
      "glass": "bg-black/40 backdrop-blur-md border border-white/10",
      "hover": "hover:border-[#f5a623]/50 transition-colors duration-300"
    },
    "inputs": {
      "style": "bg-black/50 border-white/10 focus:border-[#f5a623] text-white rounded-sm"
    }
  },
  "tech_stack": {
    "framework": "React 18",
    "styling": "Tailwind CSS",
    "ui_lib": "ShadCN UI",
    "icons": "lucide-react",
    "maps": "Mapbox GL JS",
    "charts": "Recharts",
    "animations": "Framer Motion"
  },
  "instructions_to_main_agent": [
    "Use the provided image URLs for placeholders.",
    "Implement the 'Bento Grid' layout for the dashboard sections (4-8).",
    "Ensure the 'Gold' accent is used sparingly for CTAs and key data points, do not overuse.",
    "Use 'Barlow Condensed' for all headings. Import it from Google Fonts.",
    "Maintain the 'Dark Mode' aesthetic strictly. No white backgrounds.",
    "Ensure all interactive elements have hover states (gold glow or border brighten).",
    "Add 'data-testid' to all key interactive elements."
  ],
  "universal_guidelines": [
    "Dark colors look good when used independently without gradients. DO NOT use dark colors as gradients.",
    "Create depth through layered design elements with z-index hierarchy.",
    "Use glass-morphism effects with backdrop filters (12-24px blur).",
    "Every interaction needs micro-animations.",
    "Use 2-3x more spacing than feels comfortable."
  ]
}